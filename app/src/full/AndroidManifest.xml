<?xml version="1.0" encoding="utf-8"?>
<!-- full 빌드 전용: 접근성 서비스 선언. 이 선언 하나 때문에 Play 프로텍트 EFP가 사이드로드 설치를 막는다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service android:name=".engine.HjtkAccessibility" android:exported="false"
            android:label="HJTK 화면 읽기"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/a11y_config" />
        </service>
    </application>
</manifest>
