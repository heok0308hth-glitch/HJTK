<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- HJTK와 같은 서명끼리만 주고받는다 -->
    <permission android:name="com.ht.hjtk.permission.EAR" android:protectionLevel="signature" />
    <uses-permission android:name="com.ht.hjtk.permission.EAR" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <queries>
        <package android:name="com.ht.hjtk" />
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>
    <application android:label="HJTK 통화 귀" android:icon="@mipmap/ic_launcher" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".SetupActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".EarService" android:exported="false" android:label="HJTK 통화 귀"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/ear_service" />
        </service>
    </application>
</manifest>
